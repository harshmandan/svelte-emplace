{
	"name": "svelte-emplace",
	"version": "0.1.0",
	"description": "SSR-native content emplacement for Svelte 5. Render markup where it belongs on the first pass \u2014 no DOM relocation, no wrapper element, no flash.",
	"license": "MIT",
	"type": "module",
	"keywords": [
		"svelte",
		"sveltekit",
		"ssr",
		"portal",
		"teleport",
		"slot",
		"outlet"
	],
	"files": [
		"dist",
		"!dist/**/*.test.*"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./hooks": {
			"types": "./dist/hooks.d.ts",
			"default": "./dist/hooks.js"
		}
	},
	"scripts": {
		"build": "svelte-package -i src/lib -o dist",
		"test": "bun probes/ssr.mjs && bun test --conditions=browser",
		"probe:ssr": "bun probes/ssr.mjs",
		"check": "svelte-check --tsconfig ./tsconfig.json"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"jsdom": "^25.0.1",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.5",
		"typescript": "^5.9.3",
		"vite": "^7.3.6"
	},
	"sideEffects": false,
	"dependencies": {
		"esm-env": "^1.2.2"
	}
}
