{
	"name": "svelte-emplace",
	"version": "1.1.0",
	"description": "Portals for Svelte 5 that never relocate your DOM. Content is created at its destination, so measurements, focus and close animations are right the first time.",
	"license": "MIT",
	"homepage": "https://svelte-emplace.harsh.ink",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/harshmandan/svelte-emplace.git"
	},
	"bugs": {
		"url": "https://github.com/harshmandan/svelte-emplace/issues"
	},
	"type": "module",
	"keywords": [
		"svelte",
		"portal",
		"teleport",
		"modal",
		"tooltip",
		"overlay"
	],
	"files": [
		"dist",
		"!dist/**/*.test.*"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"default": "./dist/server.js"
		}
	},
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-package -i src/lib -o dist",
		"build:site": "vite build",
		"preview": "vite preview",
		"test": "bun probes/ssr.mjs && bun test --conditions=browser",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"prepare": "svelte-kit sync",
		"prepack": "bun run build"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"jsdom": "^30.0.1",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.5",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^8.2.1"
	},
	"sideEffects": false
}
