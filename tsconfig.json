{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": [
			"ES2022",
			"DOM",
			"DOM.Iterable"
		],
		"types": [
			"node"
		],
		"strict": true,
		"checkJs": true,
		"allowJs": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"noEmit": true,
		"paths": {
			"svelte-emplace": [
				"./src/lib/index.ts"
			],
			"$lib": [
				"./src/lib"
			],
			"$lib/*": [
				"./src/lib/*"
			]
		}
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.svelte"
	]
}
